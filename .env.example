# Local preview only. server.mjs does not automatically read .env files.
# Set these in your shell, for example: PORT=4173 npm run dev
PORT=4173
# NODE_ENV=production loads dist/client and dist/server after npm run build.
# The server always binds to 127.0.0.1 and sends noindex headers.
# NODE_ENV=production

# Optional private storage location, outside public/ and dist/client/.
# Defaults to website/.preview-data (created with owner-only access).
# The preview stores non-personal configuration receipts only. Contact details,
# free-text messages, company names, notes, and marketing consent are discarded.
# It is limited to 500 receipts, with 30 API requests per minute per local client.
# Do not use this local JSON receipt store for production leads.
# PREVIEW_DATA_DIR=/absolute/private/path/to/next-jump-preview-data

# No live HubSpot, Shopify, payment, email, or analytics integration is configured.
# No portal IDs, form IDs, credentials, subscription IDs, or CRM fields are guessed.
# Release needs an approved native HubSpot form and property/context mapping;
# replace the clearly marked preview adapter only after those are verified.
# Never add credentials to browser-exposed VITE_ variables.
